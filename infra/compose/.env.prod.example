# VPS / production secrets for fiapf3-prod Compose.
# Copy to .env.prod: cp infra/compose/.env.prod.example infra/compose/.env.prod
# The account image is pulled from GHCR (see GHCR_OWNER / IMAGE_TAG).
# fiap-fase-4-dealership repeats REDIS_PASSWORD, GARAGE_* and
# KEYCLOAK_DEALERSHIP_CLIENT_SECRET with these same values.
# Replace YOUR_PUBLIC_HOST with the VPS hostname or public IP reachable by browsers.

GHCR_OWNER=andersonlorena
IMAGE_TAG=latest

UPLOAD_INTENT_SECRET=change-me-prod-upload-intent-secret

POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
# Internal Docker DNS for issuer/token endpoints used by account and dealership.
KEYCLOAK_URL=http://keycloak:8080
# Public base URL for Admin Console (nginx host keycloak.* → full proxy).
# Point DNS/hosts: keycloak.YOUR_PUBLIC_HOST → same IP as the app.
KEYCLOAK_ADMIN_URL=http://keycloak.YOUR_PUBLIC_HOST
KEYCLOAK_REALM=fiap-car-sales
# Product admin account bootstrapped by account-api (not Keycloak console admin).
ACCOUNT_BOOTSTRAP_ADMIN_EMAIL=admin@fiap-car-sales.com
ACCOUNT_BOOTSTRAP_ADMIN_PASSWORD=change-me-account-bootstrap-admin
ACCOUNT_BOOTSTRAP_ADMIN_FULL_NAME=Platform Admin
# Confidential clients (secrets also resolved into the realm import JSON).
KEYCLOAK_ACCOUNT_CLIENT_ID=account-api
KEYCLOAK_ACCOUNT_CLIENT_SECRET=change-me-account-client-secret
KEYCLOAK_DEALERSHIP_CLIENT_ID=dealership-api
KEYCLOAK_DEALERSHIP_CLIENT_SECRET=change-me-dealership-client-secret
KEYCLOAK_PAYMENT_CLIENT_ID=payment-processor
KEYCLOAK_PAYMENT_CLIENT_SECRET=change-me-payment-client-secret
ACCOUNT_API_URL=http://account:8080
ACCOUNT_S2S_ALLOWED_CLIENT_IDS=dealership-api
DEALERSHIP_PAYMENT_ALLOWED_CLIENT_IDS=payment-processor

FRONTEND_ORIGIN=http://YOUR_PUBLIC_HOST
PASSWORD_RECOVERY_URL=http://YOUR_PUBLIC_HOST/password-recovery

# Internal Docker DNS for dealership; public host for browser/presigned photo URLs.
GARAGE_ENDPOINT=http://garage:3900
GARAGE_PUBLIC_ENDPOINT=http://YOUR_PUBLIC_HOST
# Access key must be GK + 32 hex chars; secret key must be 64 hex chars.
# Generate: echo "GK$(openssl rand -hex 16)" / openssl rand -hex 32
GARAGE_ACCESS_KEY=GKabcdef0123456789abcdef0123456789
GARAGE_SECRET_KEY=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
GARAGE_BUCKET=fiapf3-vehicle-photos
# RPC secret must be 64 hex chars: openssl rand -hex 32
GARAGE_RPC_SECRET=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
GARAGE_ADMIN_TOKEN=change-me-garage-admin-token
GARAGE_METRICS_TOKEN=change-me-garage-metrics-token

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana
# Grafana via Nginx host grafana.* (DNS/hosts → same IP as the app).
GF_SERVER_ROOT_URL=http://grafana.YOUR_PUBLIC_HOST/

# Optional — leave empty to skip outbound email
RESEND_API_KEY=
RESEND_FROM=no-reply@fiapf3.local
