# Local development secrets for fiapf3-dev Compose.
# Copy to .env: cp infra/compose/.env.example infra/compose/.env
# fiap-fase-4-dealership repeats REDIS_PASSWORD, GARAGE_* and
# KEYCLOAK_DEALERSHIP_CLIENT_SECRET with these same values.

UPLOAD_INTENT_SECRET=fiapf3-dev-upload-intent-secret-change-me

POSTGRES_PASSWORD=fiapf3
REDIS_PASSWORD=fiapf3

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=fiapf3
# Internal Docker DNS for issuer/token endpoints used by account and dealership.
KEYCLOAK_URL=http://keycloak:8080
# Public base URL for Admin Console (nginx host keycloak.* → full proxy).
KEYCLOAK_ADMIN_URL=http://keycloak.localhost
KEYCLOAK_REALM=fiap-car-sales
# Product admin account bootstrapped by account-api (not Keycloak console admin).
ACCOUNT_BOOTSTRAP_ADMIN_EMAIL=admin@fiap-car-sales.com
ACCOUNT_BOOTSTRAP_ADMIN_PASSWORD=Fiapf3Admin!
ACCOUNT_BOOTSTRAP_ADMIN_FULL_NAME=Platform Admin
# Confidential clients (secrets also resolved into the realm import JSON).
KEYCLOAK_ACCOUNT_CLIENT_ID=account-api
KEYCLOAK_ACCOUNT_CLIENT_SECRET=fiapf3-account-client-secret
KEYCLOAK_DEALERSHIP_CLIENT_ID=dealership-api
KEYCLOAK_DEALERSHIP_CLIENT_SECRET=fiapf3-dealership-client-secret
KEYCLOAK_PAYMENT_CLIENT_ID=payment-processor
KEYCLOAK_PAYMENT_CLIENT_SECRET=fiapf3-payment-client-secret
ACCOUNT_API_URL=http://account:8080
ACCOUNT_S2S_ALLOWED_CLIENT_IDS=dealership-api
DEALERSHIP_PAYMENT_ALLOWED_CLIENT_IDS=payment-processor

FRONTEND_ORIGIN=http://localhost
PASSWORD_RECOVERY_URL=http://localhost/password-recovery

# Internal Docker DNS for dealership S3 client; public URL for browser/presigned photo links.
GARAGE_ENDPOINT=http://garage:3900
GARAGE_PUBLIC_ENDPOINT=http://localhost
GARAGE_ACCESS_KEY=GK0123456789abcdef0123456789abcdef
GARAGE_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GARAGE_BUCKET=fiapf3-vehicle-photos
GARAGE_RPC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GARAGE_ADMIN_TOKEN=fiapf3-dev-garage-admin-token-change-me
GARAGE_METRICS_TOKEN=fiapf3-dev-garage-metrics-token-change-me

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=fiapf3
# Grafana via Nginx host grafana.* (no host port publish).
GF_SERVER_ROOT_URL=http://grafana.localhost/

# Optional — leave empty to skip outbound email in local compose
RESEND_API_KEY=
RESEND_FROM=no-reply@fiapf3.local
